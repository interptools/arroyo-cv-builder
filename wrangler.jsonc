{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arroyo-cv-scanner",
  "compatibility_date": "2026-10-30",
  "main": "src/worker/index.ts",
  "observability": {
    "enabled": true
  },
  "vars": {
